async function renderCommDetail(){
  const comms=(await fsGet('communications')).filter(c=>c.dest==='todos'||(c.dest==='sector'&&c.sector===currentUser.sector)).sort((a,b)=>(b.fecha||'').localeCompare(a.fecha||''));
  const el=document.getElementById('comm-detail-list');
  if(!comms.length){el.innerHTML='<div class="empty-state"><p>No hay comunicaciones</p></div>';return}
  el.innerHTML=comms.map(c=>{const ur=!(c.leido||[]).includes(currentUser.id);
    const imgHtml=c.imagen?`<img class="comm-img" src="${c.imagen}" onclick="openImg(this.src)">`:'';
    return`<div class="comm-card" onclick="markRead('${c.id}')"><div class="comm-card-header"><div class="${ur?'unread-dot':'read-dot'}" style="margin-top:4px"></div><div style="flex:1"><div style="font-size:13px;font-weight:500;color:#fff">${c.titulo}</div><div style="font-size:10px;color:var(--light);margin-top:2px">${formatDateLabel(c.fecha)} · ${c.area||''}</div></div></div><div class="comm-card-body">${c.mensaje}${imgHtml}</div></div>`}).join('');
