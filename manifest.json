async function markRead(id){
  const doc=await db.collection('communications').doc(id).get();
  if(doc.exists){const d=doc.data(),l=d.leido||[];if(!l.includes(currentUser.id)){l.push(currentUser.id);await fsSet('communications',id,{leido:l})}}
  renderCommDetail();renderCommHome();
}

async function renderMonthEmp(){
  const now=new Date(),display=new Date(now.getFullYear(),now.getMonth()+empMonthOffset,1);
  const y=display.getFullYear(),m=display.getMonth();
  document.getElementById('month-label-emp').textContent=display.toLocaleDateString('es-AR',{month:'long',year:'numeric'});
  const scheds=(await fsGet('schedules')).filter(s=>s.empId===currentUser.id);
  const todayStr=fmtDate(new Date()),firstDay=(new Date(y,m,1).getDay()+6)%7,dim=new Date(y,m+1,0).getDate();
  let h='';for(let i=0;i<firstDay;i++)h+='<div class="month-cell empty"></div>';
  for(let d=1;d<=dim;d++){const ds=`${y}-${String(m+1).padStart(2,'0')}-${String(d).padStart(2,'0')}`,s=scheds.find(x=>x.fecha===ds),isT=ds===todayStr;
    let cls='free-cell',sh='';if(s){if(s.tipo==='turno'){cls=isT?'today-cell':'worked';sh=s.entrada||''}else cls='rest-cell'}else if(isT)cls='today-cell';
    h+=`<div class="month-cell ${cls}"><div class="cell-day">${d}</div><div class="cell-shift">${sh}</div></div>`}
  document.getElementById('month-grid-emp').innerHTML=h;
}
function changeMonth(dir){empMonthOffset+=dir;renderMonthEmp()}

