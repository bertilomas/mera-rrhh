// Real-time listener
let commListener=null;
function listenComms(){
  if(commListener)commListener();
  let first=true;
  commListener=db.collection('communications').onSnapshot(snap=>{
    if(first){first=false;return}
    snap.docChanges().forEach(change=>{
      if(change.type==='added'){
        const d=change.doc.data();
        if(d.dest==='todos'||(d.dest==='sector'&&d.sector===currentUser.sector)){
          showToast('Nueva comunicación: '+d.titulo);
          if(Notification.permission==='granted'){new Notification('Mera RRHH',{body:d.titulo,icon:'icons/icon-192.png'})}
        }
      }
    });
    renderCommHome();
  });
}

