// COMUNICACIONES
let commImageB64='';
function previewCommImg(input){
  const file=input.files[0];if(!file)return;
  const reader=new FileReader();
  reader.onload=e=>{
    const img=new Image();img.onload=()=>{
      const max=800,c=document.createElement('canvas');let w=img.width,h=img.height;
      if(w>max){h=h*(max/w);w=max}c.width=w;c.height=h;
      c.getContext('2d').drawImage(img,0,0,w,h);
      commImageB64=c.toDataURL('image/jpeg',0.7);
      document.getElementById('comm-img-preview').innerHTML=`<div class="img-preview"><img src="${commImageB64}"><button class="img-remove" onclick="clearCommImg()">✕</button></div>`;
    };img.src=e.target.result;
  };reader.readAsDataURL(file);
}
function clearCommImg(){commImageB64='';document.getElementById('comm-img-preview').innerHTML='';document.getElementById('comm-img-input').value=''}
async function sendComm(){
  const titulo=document.getElementById('comm-titulo').value.trim(),dest=document.getElementById('comm-dest').value,sector=document.getElementById('comm-sector').value.trim(),mensaje=document.getElementById('comm-mensaje').value.trim(),area=document.getElementById('comm-area').value.trim();
  if(!titulo||!mensaje){showToast('Completá título y mensaje');return}
  document.getElementById('comm-send-btn').disabled=true;
  await fsAdd('communications',{titulo,mensaje,area:area||'RRHH',dest,sector,fecha:fmtDate(new Date()),leido:[],imagen:commImageB64});
  document.getElementById('comm-titulo').value='';document.getElementById('comm-mensaje').value='';document.getElementById('comm-area').value='';document.getElementById('comm-sector').value='';clearCommImg();
  document.getElementById('comm-send-btn').disabled=false;
  renderCommSent();showToast('Comunicación enviada ✓');
}
async function renderCommSent(){
  const comms=(await fsGet('communications')).sort((a,b)=>(b.fecha||'').localeCompare(a.fecha||''));
  const el=document.getElementById('comm-sent-list');
  if(!comms.length){el.innerHTML='<div class="empty-state"><p>Sin comunicaciones</p></div>';return}
  el.innerHTML=comms.map(c=>`<div style="padding:10px 0;border-bottom:0.5px solid var(--separator);display:flex;justify-content:space-between;align-items:flex-start;gap:8px"><div style="flex:1"><div style="font-size:12px;font-weight:500;color:#fff">${c.titulo}</div><div style="font-size:10px;color:var(--light);margin-top:3px">${formatDateLabel(c.fecha)} · ${c.area||''} · ${c.dest==='todos'?'Todos':c.sector}${c.imagen?' · 📷':''}</div></div><button class="a-btn-sm del" onclick="delComm('${c.id}')">✕</button></div>`).join('');
}
async function delComm(id){await fsDel('communications',id);renderCommSent();showToast('Eliminada')}

// HORARIOS
async function renderScheduleSelects(){
  const users=(await fsGet('users')).filter(u=>u.role==='employee'&&u.active!==false);
  const opts=users.map(u=>`<option value="${u.id}">${u.name}</option>`).join('');
  document.getElementById('sched-emp').innerHTML=opts||'<option>Sin empleados</option>';
  document.getElementById('sched-filter-emp').innerHTML='<option value="todos">Todos</option>'+opts;
  document.getElementById('rec-emp').innerHTML=opts||'<option>Sin empleados</option>';
  document.getElementById('rec-filter-emp').innerHTML='<option value="todos">Todos</option>'+opts;
}
async function addSchedule(){
  const empId=document.getElementById('sched-emp').value,fecha=document.getElementById('sched-fecha').value,tipo=document.getElementById('sched-tipo').value;
  if(!empId||!fecha){showToast('Seleccioná empleado y fecha');return}
  const existing=(await fsGet('schedules')).find(s=>s.empId===empId&&s.fecha===fecha);
  const data={empId,fecha,tipo,...(tipo==='turno'?{entrada:document.getElementById('sched-entrada').value,salida:document.getElementById('sched-salida').value}:{entrada:'',salida:''})};
  if(existing)await fsSet('schedules',existing.id,data);else await fsAdd('schedules',data);
  document.getElementById('sched-fecha').value='';renderScheduleList();showToast('Horario guardado ✓');
}
async function importSchedule(input){
  const file=input.files[0];if(!file)return;const text=await file.text();
  let entries=[];const users=await fsGet('users');
  if(file.name.endsWith('.json')){try{entries=JSON.parse(text)}catch{showToast('Error JSON');return}}
  else{const lines=text.split('\n').filter(l=>l.trim());const hdr=lines[0].toLowerCase().split(',').map(s=>s.trim());
    for(let i=1;i<lines.length;i++){const vals=lines[i].split(',').map(s=>s.trim()),row={};hdr.forEach((h,j)=>row[h]=vals[j]||'');
      const u=users.find(x=>x.username===row.usuario||x.name===row.nombre);
      if(u&&row.fecha)entries.push({empId:u.id,fecha:row.fecha,tipo:row.tipo||'turno',...(row.entrada?{entrada:row.entrada}:{}),...(row.salida?{salida:row.salida}:{})})}}
  let added=0;const scheds=await fsGet('schedules');
  for(const e of entries){if(!e.empId||!e.fecha)continue;const ex=scheds.find(s=>s.empId===e.empId&&s.fecha===e.fecha);
    if(ex)await fsSet('schedules',ex.id,e);else await fsAdd('schedules',e);added++}
  document.getElementById('import-preview').innerHTML=`<div style="font-size:12px;color:var(--green-text);background:var(--green-bg);padding:8px 12px;border-radius:8px">${added} registros importados ✓</div>`;
  renderScheduleList();input.value='';
}
async function renderScheduleList(){
  const filter=document.getElementById('sched-filter-emp').value;
  let scheds=(await fsGet('schedules')).sort((a,b)=>(b.fecha||'').localeCompare(a.fecha||'')).slice(0,30);
  if(filter!=='todos')scheds=scheds.filter(s=>s.empId===filter);
  const users=await fsGet('users');const el=document.getElementById('sched-list-wrap');
  if(!scheds.length){el.innerHTML='<div class="empty-state"><p>Sin horarios</p></div>';return}
  el.innerHTML=`<table class="a-table"><thead><tr><th>Empleado</th><th>Fecha</th><th>Tipo</th><th>Turno</th><th></th></tr></thead><tbody>${scheds.map(s=>{const u=users.find(x=>x.id===s.empId);
    return`<tr><td>${u?u.name.split(' ')[0]:'—'}</td><td style="color:var(--light);font-size:11px">${s.fecha}</td><td><span class="stag ${s.tipo==='turno'?'active':'inactive'}">${s.tipo}</span></td><td style="font-size:11px;color:var(--light)">${s.tipo==='turno'&&s.entrada?s.entrada+'–'+s.salida:s.tipo}</td><td><button class="a-btn-sm del" onclick="delSched('${s.id}')">✕</button></td></tr>`}).join('')}</tbody></table>`;
}
async function delSched(id){await fsDel('schedules',id);renderScheduleList()}

