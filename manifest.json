<script>
// ═══════════════════════════════════════
// FIREBASE INIT
// ═══════════════════════════════════════
firebase.initializeApp({
  apiKey: "AIzaSyBjcjYxXOOQDheWGZlG6yYoquj9iOG4UNY",
  authDomain: "mera-app-push.firebaseapp.com",
  projectId: "mera-app-push",
  storageBucket: "mera-app-push.firebasestorage.app",
  messagingSenderId: "294872680860",
  appId: "1:294872680860:web:2c3d18cc2c637cd9912059",
  measurementId: "G-7DW7VFH8VS"
});
const db = firebase.firestore();

// Unregister old SWs
if('serviceWorker' in navigator) navigator.serviceWorker.getRegistrations().then(r=>r.forEach(x=>x.unregister()));

// ═══════════════════════════════════════
// HELPERS
// ═══════════════════════════════════════
function fmtDate(d){return d.toISOString().split('T')[0]}
function formatDateLabel(ds){
  if(!ds)return'';const t=fmtDate(new Date()),y=fmtDate(new Date(Date.now()-864e5));
  if(ds===t)return'Hoy';if(ds===y)return'Ayer';
  return new Date(ds+'T00:00:00').toLocaleDateString('es-AR',{day:'numeric',month:'short'});
}
function showToast(m){const t=document.getElementById('toast');t.textContent=m;t.classList.add('show');setTimeout(()=>t.classList.remove('show'),2200)}
function initials(n){return n?n.split(' ').map(x=>x[0]).slice(0,2).join('').toUpperCase():''}
const DEMO_USERS=[
  {name:'Administrador RRHH',username:'admin',password:'1234',role:'admin',sector:'RRHH',puesto:'Administrador',email:'admin@merasolutions.com.ar',active:true},
  {name:'Juan Martínez',username:'empleado',password:'1234',role:'employee',sector:'Ventas',puesto:'Analista',email:'jmartinez@merasolutions.com.ar',active:true},
  {name:'María González',username:'mgonzalez',password:'1234',role:'employee',sector:'Administración',puesto:'Contadora',email:'mgonzalez@merasolutions.com.ar',active:true}
];

// ═══════════════════════════════════════
// FIRESTORE HELPERS
// ═══════════════════════════════════════
async function fsGet(col){const s=await db.collection(col).get();return s.docs.map(d=>({id:d.id,...d.data()}))}
async function fsAdd(col,data){const r=await db.collection(col).add(data);return r.id}
async function fsSet(col,id,data){await db.collection(col).doc(id).set(data,{merge:true})}
async function fsDel(col,id){await db.collection(col).doc(id).delete()}

// ═══════════════════════════════════════
// INIT SEED DATA
// ═══════════════════════════════════════
async function seedIfEmpty(){
  const users=await fsGet('users');
  if(!users.length){
    for(const u of DEMO_USERS) await fsAdd('users',u);
    const allU=await fsGet('users');
    const emp1=allU.find(u=>u.username==='empleado');
    const emp2=allU.find(u=>u.username==='mgonzalez');
    const today=fmtDate(new Date()),yest=fmtDate(new Date(Date.now()-864e5));
    await fsAdd('communications',{titulo:'Bienvenidos al portal RRHH',mensaje:'Este es el nuevo portal de Recursos Humanos de Mera Solutions.',area:'RRHH',dest:'todos',sector:'',fecha:yest,leido:[],imagen:''});
    await fsAdd('communications',{titulo:'Actualización de políticas de vacaciones',mensaje:'A partir del 1 de julio, el proceso de solicitud de vacaciones se realizará exclusivamente por este portal.',area:'RRHH',dest:'todos',sector:'',fecha:today,leido:[],imagen:''});
    if(emp1){
      const hoy=new Date();
      for(let i=-3;i<=10;i++){const d=new Date(hoy);d.setDate(hoy.getDate()+i);const dow=d.getDay(),ds=fmtDate(d);
        if(dow===0||dow===6){await fsAdd('schedules',{empId:emp1.id,fecha:ds,tipo:'libre'});if(emp2)await fsAdd('schedules',{empId:emp2.id,fecha:ds,tipo:'franco'})}
        else{await fsAdd('schedules',{empId:emp1.id,fecha:ds,tipo:'turno',entrada:'08:00',salida:'16:00'});if(emp2)await fsAdd('schedules',{empId:emp2.id,fecha:ds,tipo:'turno',entrada:'09:00',salida:'17:00'})}
      }
      await fsAdd('recognitions',{empId:emp1.id,tipo:'reconocimiento',desc:'Excelente atención al cliente',supervisor:'Sup. García',fecha:fmtDate(new Date(Date.now()-6*864e5))});
      await fsAdd('recognitions',{empId:emp1.id,tipo:'sancion',desc:'Tardanza no justificada',supervisor:'RRHH',fecha:fmtDate(new Date(Date.now()-9*864e5))});
      if(emp2)await fsAdd('recognitions',{empId:emp2.id,tipo:'reconocimiento',desc:'Presentación destacada ante directorio',supervisor:'Dirección',fecha:fmtDate(new Date(Date.now()-3*864e5))});
    }
    showToast('Datos demo cargados ✓');
  }
}

// ═══════════════════════════════════════
// AUTH
// ═══════════════════════════════════════
let currentUser=null;
async function doLogin(){
  const u=document.getElementById('login-user').value.trim().toLowerCase();
  const p=document.getElementById('login-pass').value.trim();
  const err=document.getElementById('login-error');
  if(!u||!p){err.textContent='Completá usuario y contraseña';return}
  err.textContent='Verificando...';
  try{
    let users=await fsGet('users');
    // Fallback demo
    DEMO_USERS.forEach(d=>{if(!users.find(x=>x.username===d.username)){users.push(d)}});
    const found=users.find(x=>x.username===u&&x.password===p&&x.active!==false);
    if(!found){err.textContent='Usuario o contraseña incorrectos.';return}
    err.textContent='';currentUser=found;
    if(found.role==='admin')openAdmin();else openEmployee();
    setupFCM();
  }catch(e){err.textContent='Error de conexión. Reintentá.';console.error(e)}
}
function doLogout(){currentUser=null;document.getElementById('login-user').value='';document.getElementById('login-pass').value='';showScreen('login');showEmpTab('home')}
document.addEventListener('keydown',e=>{if(e.key==='Enter'&&document.getElementById('screen-login').classList.contains('active'))doLogin()});

// ═══════════════════════════════════════
// SCREENS
// ═══════════════════════════════════════
function showScreen(id){document.querySelectorAll('.screen').forEach(s=>s.classList.remove('active'));document.getElementById('screen-'+id).classList.add('active')}

// ═══════════════════════════════════════
// EMPLOYEE
// ═══════════════════════════════════════
let empMonthOffset=0;
async function openEmployee(){
  showScreen('employee');
  const u=currentUser;
  document.getElementById('emp-avatar').textContent=initials(u.name);
  document.getElementById('emp-name').textContent=u.name;
