  document.getElementById('prof-name').textContent=u.name;
  document.getElementById('prof-role-txt').textContent=(u.puesto||'')+' · '+(u.sector||'');
  document.getElementById('prof-card').innerHTML=`
    <div class="profile-row"><span class="profile-key">Sector</span><span class="profile-val">${u.sector||''}</span></div>
    <div class="profile-row"><span class="profile-key">Puesto</span><span class="profile-val">${u.puesto||''}</span></div>
    <div class="profile-row"><span class="profile-key">Email</span><span class="profile-val" style="font-size:11px">${u.email||''}</span></div>
    <div class="profile-row"><span class="profile-key">Usuario</span><span class="profile-val">${u.username}</span></div>`;
