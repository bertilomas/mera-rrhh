async function renderCommHome(){
  const comms=(await fsGet('communications')).filter(c=>c.dest==='todos'||(c.dest==='sector'&&c.sector===currentUser.sector)).sort((a,b)=>(b.fecha||'').localeCompare(a.fecha||''));
  const unread=comms.filter(c=>!(c.leido||[]).includes(currentUser.id));
  document.getElementById('home-comm-sub').textContent=unread.length?`${unread.length} sin leer`:'Todo leído';
  document.getElementById('notif-dot').className='notif-dot'+(unread.length?' show':'');
  const el=document.getElementById('home-comm-list');
  if(!comms.length){el.innerHTML='<div class="empty-state"><p>No hay comunicaciones</p></div>';return}
  el.innerHTML=comms.slice(0,3).map(c=>{const ur=!(c.leido||[]).includes(currentUser.id);
    return`<div class="row-item"><div class="${ur?'unread-dot':'read-dot'}"></div><div><div class="row-title${ur?'':' read'}">${c.titulo}</div><div class="row-meta">${formatDateLabel(c.fecha)} · ${c.area||''}</div></div></div>`}).join('');
}

async function renderSchedHome(){
  const scheds=(await fsGet('schedules')).filter(s=>s.empId===currentUser.id);
  const today=fmtDate(new Date()),now=new Date(),startW=new Date(now);const dow2=startW.getDay()||7;startW.setDate(startW.getDate()-dow2+1);
  const days=['Lun','Mar','Mié','Jue','Vie','Sáb','Dom'];
  let h='<div style="font-size:11px;color:var(--lighter);margin-bottom:8px">Esta semana</div><div class="day-grid">';
  for(let i=0;i<7;i++){const d=new Date(startW);d.setDate(startW.getDate()+i);const ds=fmtDate(d),isT=ds===today,s=scheds.find(x=>x.fecha===ds);
    let cls='free',mk='—',hr='';
    if(s){if(s.tipo==='turno'){cls=isT?'today':'worked';mk=isT?'●':'✓';hr=s.entrada||''}else{cls='rest';mk='L'}}else if(isT){cls='today';mk='●'}
    h+=`<div class="day-col"><div class="day-lbl">${days[i]}</div><div class="day-pill ${cls}"><div class="dp-mark">${mk}</div><div class="dp-hour">${hr}</div></div></div>`}
  h+='</div>';document.getElementById('home-week-grid').innerHTML=h;
  const ts=scheds.find(s=>s.fecha===today);
  document.getElementById('shift-text').textContent=ts&&ts.tipo==='turno'?`Turno hoy: ${ts.entrada} – ${ts.salida} hs`:ts?'Hoy: Día libre / Franco':'Sin turno asignado hoy';
}

async function renderRecHome(){
  const now=new Date(),ago=new Date(now);ago.setDate(ago.getDate()-30);
  const recs=(await fsGet('recognitions')).filter(r=>r.empId===currentUser.id&&new Date(r.fecha)>=ago);
  const rc=recs.filter(r=>r.tipo==='reconocimiento').length,sc=recs.filter(r=>r.tipo==='sancion').length;
  document.getElementById('home-rec-count').textContent=rc;document.getElementById('home-san-count').textContent=sc;
  const el=document.getElementById('home-rec-items');
  if(!recs.length){el.innerHTML='<div class="empty-state" style="padding:10px 0"><p>Sin registros este mes</p></div>';return}
  el.innerHTML=recs.slice(0,3).map(r=>`<div class="row-item"><div class="rec-badge ${r.tipo==='reconocimiento'?'pos':'neg'}" style="width:28px;height:28px;font-size:14px">${r.tipo==='reconocimiento'?'★':'!'}</div><div style="flex:1"><div class="row-title">${r.desc}</div><div class="row-meta">${formatDateLabel(r.fecha)} · ${r.supervisor||''}</div></div><div class="rec-tag ${r.tipo==='reconocimiento'?'pos':'neg'}">${r.tipo==='reconocimiento'?'+1':'−1'}</div></div>`).join('');
}

