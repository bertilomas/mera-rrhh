<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>Mera Solutions · RRHH</title>
<link rel="manifest" href="manifest.json">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="Mera RRHH">
<meta name="theme-color" content="#1a237e">
<link rel="apple-touch-icon" href="icons/icon-152.png">
<link rel="icon" type="image/png" sizes="192x192" href="icons/icon-192.png">
<script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-app-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-firestore-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-messaging-compat.js"></script>
<style>
*{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent}
html,body{height:100%;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;background:#eef1f8;color:#1a237e;overflow:hidden}
:root{--navy:#1a237e;--navy2:#283593;--blue:#3949ab;--blue2:#5c6bc0;--light:#9fa8da;--lighter:#c5cae9;--bg:#eef1f8;--white:#fff;--green:#388e3c;--green-bg:rgba(76,175,80,0.18);--green-text:#a5d6a7;--red:#c62828;--red-bg:rgba(233,30,99,0.18);--red-text:#f48fb1;--card-text:#e8eaf6;--separator:rgba(255,255,255,0.12);--radius:20px;--radius-sm:12px;--radius-xs:10px}
#app{height:100vh;display:flex;flex-direction:column;overflow:hidden}
.screen{display:none;flex-direction:column;height:100%;overflow:hidden}
.screen.active{display:flex}

/* LOGIN */
#screen-login{background:var(--navy);align-items:center;justify-content:center;padding:24px}
.login-logo{text-align:center;margin-bottom:36px}
.login-logo-circle{width:72px;height:72px;border-radius:20px;background:rgba(255,255,255,0.12);display:flex;align-items:center;justify-content:center;font-size:32px;font-weight:700;color:#fff;margin:0 auto 12px;letter-spacing:-1px}
.login-logo h1{font-size:20px;font-weight:600;color:#fff}
.login-logo p{font-size:12px;color:var(--light);margin-top:4px}
.login-card{background:rgba(255,255,255,0.08);border-radius:var(--radius);padding:28px 24px;width:100%;max-width:360px;border:0.5px solid rgba(255,255,255,0.15)}
.login-field{margin-bottom:16px}
.login-field label{display:block;font-size:11px;color:var(--lighter);font-weight:500;margin-bottom:6px}
.login-field input{width:100%;background:rgba(255,255,255,0.1);border:0.5px solid rgba(255,255,255,0.2);border-radius:var(--radius-xs);padding:12px 14px;font-size:14px;color:#fff;outline:none}
.login-field input::placeholder{color:rgba(255,255,255,0.35)}
.login-btn{width:100%;padding:13px;background:#fff;color:var(--navy);font-size:14px;font-weight:600;border:none;border-radius:var(--radius-xs);cursor:pointer;margin-top:8px}
.login-error{font-size:12px;color:#ef9a9a;text-align:center;margin-top:10px;min-height:18px}
.login-hint{text-align:center;margin-top:16px;font-size:11px;color:rgba(255,255,255,0.3)}

/* TOPBAR */
.topbar{background:var(--navy);padding:14px 18px;display:flex;align-items:center;justify-content:space-between;flex-shrink:0}
.topbar-left{display:flex;align-items:center;gap:10px}
.avatar{width:34px;height:34px;border-radius:10px;background:var(--blue);display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:600;color:var(--lighter);flex-shrink:0}
.tb-name{font-size:13px;font-weight:500;color:#fff}
.tb-role{font-size:10px;color:var(--light);margin-top:1px}
.topbar-right{display:flex;gap:14px;align-items:center}
.tb-icon{font-size:22px;color:var(--lighter);cursor:pointer;position:relative;background:none;border:none;padding:0}
.notif-dot{position:absolute;top:-2px;right:-2px;width:7px;height:7px;background:#ef5350;border-radius:50%;border:1.5px solid var(--navy);display:none}
.notif-dot.show{display:block}

/* SCROLL BODY */
.scroll-body{flex:1;overflow-y:auto;padding:16px 14px 80px;display:flex;flex-direction:column;gap:12px;-webkit-overflow-scrolling:touch}
.greeting{font-size:15px;font-weight:500;color:var(--navy)}
.greeting-sub{font-size:11px;color:var(--blue2);margin-top:2px}

/* MODULE CARDS */
.mod-card{background:var(--navy);border-radius:var(--radius);overflow:hidden}
.mod-header{display:flex;align-items:center;justify-content:space-between;padding:14px 16px 12px;border-bottom:0.5px solid var(--separator);cursor:pointer}
.mod-header-left{display:flex;align-items:center;gap:10px}
.mod-icon{width:38px;height:38px;border-radius:var(--radius-sm);display:flex;align-items:center;justify-content:center;font-size:20px;background:rgba(255,255,255,0.13);color:#fff;flex-shrink:0}
.mod-title{font-size:14px;font-weight:500;color:#fff}
.mod-sub{font-size:11px;color:var(--light);margin-top:1px}
.mod-arrow{font-size:18px;color:rgba(255,255,255,0.35)}
.mod-body{padding:12px 16px 14px}

.row-item{display:flex;align-items:flex-start;gap:10px;padding:7px 0;border-bottom:0.5px solid var(--separator)}
.row-item:last-child{border-bottom:none;padding-bottom:0}
.unread-dot{width:7px;height:7px;border-radius:50%;background:#82b1ff;flex-shrink:0;margin-top:4px}
.read-dot{width:7px;height:7px;flex-shrink:0}
.row-title{font-size:12px;font-weight:500;color:var(--card-text)}
.row-title.read{color:var(--blue2);font-weight:400}
.row-meta{font-size:10px;color:var(--light);margin-top:1px}

/* Schedule */
.day-grid{display:grid;grid-template-columns:repeat(7,1fr);gap:4px}
.day-col{display:flex;flex-direction:column;align-items:center;gap:3px}
.day-lbl{font-size:9px;color:var(--light);font-weight:500}
.day-pill{width:100%;border-radius:var(--radius-xs);padding:6px 2px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:1px}
.day-pill.worked{background:var(--blue)}
.day-pill.today{background:#fff}
.day-pill.rest{background:rgba(255,255,255,0.07)}
.day-pill.free{background:rgba(255,255,255,0.04);border:0.5px dashed rgba(255,255,255,0.18)}
.dp-mark{font-size:9px;font-weight:600}
.day-pill.worked .dp-mark{color:#fff}
.day-pill.today .dp-mark{color:var(--navy)}
.day-pill.rest .dp-mark{color:var(--light)}
.dp-hour{font-size:7.5px;font-weight:500}
.day-pill.worked .dp-hour{color:var(--lighter)}
.day-pill.today .dp-hour{color:var(--blue2)}
.day-pill.rest .dp-hour,.day-pill.free .dp-hour{color:rgba(255,255,255,0.25)}
.shift-pill{background:rgba(255,255,255,0.09);border-radius:var(--radius-xs);padding:6px 10px;margin-top:10px;font-size:11px;color:var(--lighter);font-weight:500;display:flex;align-items:center;gap:6px}

/* Rec & sanciones */
.sum-pills{display:flex;gap:6px;margin-bottom:10px}
.sum-pill{flex:1;border-radius:var(--radius-sm);padding:8px 6px;display:flex;flex-direction:column;align-items:center;gap:2px}
.sum-pill.pos{background:var(--green-bg)}
.sum-pill.neg{background:var(--red-bg)}
.sum-num{font-size:20px;font-weight:500}
.sum-pill.pos .sum-num{color:var(--green-text)}
.sum-pill.neg .sum-num{color:var(--red-text)}
.sum-lbl{font-size:9px;font-weight:500}
.sum-pill.pos .sum-lbl{color:#81c784}
.sum-pill.neg .sum-lbl{color:#f06292}
.rec-badge{width:32px;height:32px;border-radius:var(--radius-xs);display:flex;align-items:center;justify-content:center;font-size:17px;flex-shrink:0}
.rec-badge.pos{background:var(--green-bg);color:var(--green-text)}
.rec-badge.neg{background:var(--red-bg);color:var(--red-text)}
.rec-tag{margin-left:auto;flex-shrink:0;font-size:10px;font-weight:600;padding:3px 8px;border-radius:20px}
.rec-tag.pos{background:var(--green-bg);color:var(--green-text)}
.rec-tag.neg{background:var(--red-bg);color:var(--red-text)}

/* BOTTOM NAV */
.bottomnav{position:absolute;bottom:0;left:0;right:0;background:#fff;border-top:0.5px solid #dde2f0;display:flex;justify-content:space-around;align-items:center;padding:8px 0 max(12px,env(safe-area-inset-bottom));flex-shrink:0;z-index:10}
.nav-item{display:flex;flex-direction:column;align-items:center;gap:3px;cursor:pointer;min-width:50px;padding:2px 0;border:none;background:none}
.nav-item svg{width:24px;height:24px;stroke:var(--lighter);fill:none;stroke-width:1.8}
.nav-item.active svg{stroke:var(--navy)}
.nav-lbl{font-size:9px;color:var(--lighter);font-weight:500}
.nav-item.active .nav-lbl{color:var(--navy)}
.nav-dot{width:4px;height:4px;border-radius:50%;background:var(--navy);display:none}
.nav-item.active .nav-dot{display:block}

/* DETAIL */
.detail-header{background:var(--navy);padding:14px 18px;display:flex;align-items:center;gap:12px;flex-shrink:0}
.back-btn{background:none;border:none;cursor:pointer;padding:4px;color:var(--lighter);font-size:22px;display:flex;align-items:center}
.detail-title{font-size:15px;font-weight:500;color:#fff}
.detail-body{flex:1;overflow-y:auto;padding:14px;display:flex;flex-direction:column;gap:10px;background:var(--bg)}

/* Comm cards */
.comm-card{background:var(--navy);border-radius:var(--radius);overflow:hidden;cursor:pointer}
.comm-card-header{padding:14px 16px;display:flex;align-items:flex-start;gap:12px}
.comm-card-body{padding:0 16px 14px;font-size:12px;color:var(--light);line-height:1.6}
.comm-img{width:100%;border-radius:var(--radius-xs);margin-top:8px;max-height:300px;object-fit:cover}
.comm-full{background:var(--navy);border-radius:var(--radius);padding:18px 16px}
.comm-full-title{font-size:15px;font-weight:500;color:#fff;margin-bottom:6px}
.comm-full-meta{font-size:11px;color:var(--light);margin-bottom:14px;padding-bottom:12px;border-bottom:0.5px solid var(--separator)}
.comm-full-body{font-size:13px;color:var(--card-text);line-height:1.7}
.comm-full-img{width:100%;border-radius:var(--radius-sm);margin-top:12px;cursor:pointer}

/* Month grid */
.month-header{display:flex;justify-content:space-between;align-items:center;margin-bottom:10px}
.month-label{font-size:13px;font-weight:500;color:#fff}
.month-grid-header{display:grid;grid-template-columns:repeat(7,1fr);gap:2px;margin-bottom:4px}
.month-grid-header span{font-size:9px;text-align:center;color:var(--light);font-weight:500}
.month-grid{display:grid;grid-template-columns:repeat(7,1fr);gap:2px}
.month-cell{aspect-ratio:1;border-radius:8px;display:flex;flex-direction:column;align-items:center;justify-content:center;font-size:9px;font-weight:500}
.month-cell.empty{background:transparent}
.month-cell.worked{background:var(--blue);color:var(--lighter)}
.month-cell.today-cell{background:#fff;color:var(--navy)}
.month-cell.rest-cell{background:rgba(255,255,255,0.07);color:var(--light)}
.month-cell.free-cell{background:rgba(255,255,255,0.04);color:rgba(255,255,255,0.25);border:0.5px dashed rgba(255,255,255,0.2)}
.month-cell .cell-day{font-size:11px;font-weight:600}
.month-cell .cell-shift{font-size:7px;margin-top:1px}

/* Rec detail */
.rec-filter{display:flex;gap:6px;margin-bottom:2px}
.filter-btn{padding:5px 12px;border-radius:20px;font-size:11px;font-weight:500;cursor:pointer;border:0.5px solid #c5cae9;background:#fff;color:var(--navy2)}
.filter-btn.active{background:var(--navy);color:#fff;border-color:var(--navy)}
.rec-full-card{background:var(--navy);border-radius:var(--radius);overflow:hidden}
.rec-full-row{display:flex;align-items:center;gap:12px;padding:12px 16px;border-bottom:0.5px solid var(--separator)}
.rec-full-row:last-child{border-bottom:none}
.rec-icon-lg{width:38px;height:38px;border-radius:var(--radius-xs);display:flex;align-items:center;justify-content:center;font-size:20px;flex-shrink:0}
.rec-icon-lg.pos{background:var(--green-bg);color:var(--green-text)}
.rec-icon-lg.neg{background:var(--red-bg);color:var(--red-text)}
.rec-desc{font-size:12px;font-weight:500;color:var(--card-text)}
.rec-who-date{font-size:10px;color:var(--light);margin-top:2px}
.rec-type-tag{margin-left:auto;flex-shrink:0;font-size:10px;font-weight:600;padding:4px 10px;border-radius:20px}
.rec-type-tag.pos{background:var(--green-bg);color:var(--green-text)}
.rec-type-tag.neg{background:var(--red-bg);color:var(--red-text)}

/* Profile */
.profile-header{background:var(--navy);padding:24px 18px 20px;text-align:center;flex-shrink:0}
.profile-avatar{width:60px;height:60px;border-radius:18px;background:var(--blue);display:flex;align-items:center;justify-content:center;font-size:22px;font-weight:600;color:var(--lighter);margin:0 auto 10px}
.profile-name{font-size:16px;font-weight:500;color:#fff}
.profile-role{font-size:11px;color:var(--light);margin-top:2px}
.profile-card{background:var(--navy);border-radius:var(--radius);overflow:hidden}
.profile-row{display:flex;align-items:center;justify-content:space-between;padding:12px 16px;border-bottom:0.5px solid var(--separator)}
.profile-row:last-child{border-bottom:none}
.profile-key{font-size:12px;color:var(--light)}
.profile-val{font-size:12px;font-weight:500;color:var(--card-text);text-align:right}
.profile-logout{width:100%;padding:12px;background:var(--red-bg);color:var(--red-text);font-size:13px;font-weight:600;border:none;border-radius:var(--radius-xs);cursor:pointer;font-family:inherit;margin-top:4px}

/* ADMIN */
#screen-admin{background:var(--bg)}
.admin-topbar{background:var(--navy);padding:14px 18px;display:flex;align-items:center;justify-content:space-between;flex-shrink:0}
.admin-title{font-size:15px;font-weight:600;color:#fff}
.admin-subtitle{font-size:10px;color:var(--light);margin-top:1px}
.logout-btn{background:rgba(255,255,255,0.12);border:none;border-radius:8px;color:var(--lighter);font-size:11px;padding:6px 12px;cursor:pointer;font-weight:500}
.admin-tabs{display:flex;background:var(--navy2);flex-shrink:0;overflow-x:auto;-webkit-overflow-scrolling:touch}
.admin-tab{padding:10px 16px;font-size:12px;font-weight:500;color:var(--lighter);cursor:pointer;white-space:nowrap;border-bottom:2px solid transparent;flex-shrink:0}
.admin-tab.active{color:#fff;border-bottom-color:#fff}
.admin-body{flex:1;overflow-y:auto;padding:14px;display:flex;flex-direction:column;gap:12px}
.admin-panel{display:none}
.admin-panel.active{display:flex;flex-direction:column;gap:12px}
.a-card{background:var(--navy);border-radius:var(--radius);padding:16px}
.a-card-title{font-size:13px;font-weight:500;color:#fff;margin-bottom:12px}

/* Forms */
.f-group{margin-bottom:12px}
.f-label{font-size:11px;color:var(--light);font-weight:500;margin-bottom:5px;display:block}
.f-input,.f-select,.f-textarea{width:100%;background:rgba(255,255,255,0.09);border:0.5px solid rgba(255,255,255,0.18);border-radius:var(--radius-xs);padding:10px 12px;font-size:13px;color:#fff;outline:none;font-family:inherit;appearance:none}
.f-select option{background:var(--navy2);color:#fff}
.f-textarea{resize:vertical;min-height:80px;line-height:1.5}
.f-input::placeholder,.f-textarea::placeholder{color:rgba(255,255,255,0.3)}
.f-row{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.f-btn{width:100%;padding:12px;background:#fff;color:var(--navy);font-size:13px;font-weight:600;border:none;border-radius:var(--radius-xs);cursor:pointer;font-family:inherit}
.f-btn.secondary{background:rgba(255,255,255,0.12);color:#fff}
.f-btn:disabled{opacity:0.5}
.a-table{width:100%;border-collapse:collapse;font-size:12px}
.a-table th{text-align:left;font-size:10px;font-weight:500;color:var(--light);padding:0 0 8px;border-bottom:0.5px solid var(--separator)}
.a-table td{padding:9px 0;border-bottom:0.5px solid var(--separator);color:var(--card-text);vertical-align:middle}
.a-table tr:last-child td{border-bottom:none}
.a-btn-sm{padding:4px 10px;border-radius:8px;font-size:10px;font-weight:500;cursor:pointer;border:none;font-family:inherit}
.a-btn-sm.edit{background:rgba(255,255,255,0.12);color:var(--lighter)}
.a-btn-sm.del{background:var(--red-bg);color:var(--red-text)}
.stag{font-size:10px;font-weight:500;padding:2px 8px;border-radius:20px;display:inline-block}
.stag.active{background:var(--green-bg);color:var(--green-text)}
.stag.inactive{background:rgba(255,255,255,0.08);color:var(--light)}

/* Upload */
.upload-zone{border:1.5px dashed rgba(255,255,255,0.25);border-radius:var(--radius-xs);padding:16px;text-align:center;cursor:pointer}
.upload-zone p{font-size:12px;color:var(--light);margin-top:4px}
.upload-zone input{display:none}

/* Image preview */
.img-preview{position:relative;display:inline-block;margin-top:8px}
.img-preview img{max-width:100%;max-height:180px;border-radius:var(--radius-xs)}
.img-remove{position:absolute;top:4px;right:4px;background:rgba(0,0,0,0.6);color:#fff;border:none;border-radius:50%;width:22px;height:22px;font-size:14px;cursor:pointer;display:flex;align-items:center;justify-content:center}

/* Image modal */
.img-modal{position:fixed;inset:0;background:rgba(0,0,0,0.9);z-index:300;display:none;align-items:center;justify-content:center;padding:20px}
.img-modal.show{display:flex}
.img-modal img{max-width:100%;max-height:90vh;border-radius:8px}
.img-modal-close{position:absolute;top:16px;right:16px;background:rgba(255,255,255,0.2);color:#fff;border:none;border-radius:50%;width:36px;height:36px;font-size:20px;cursor:pointer}

/* Modal */
.modal-overlay{position:fixed;inset:0;background:rgba(0,0,0,0.55);z-index:200;display:none;align-items:flex-end}
.modal-overlay.show{display:flex}
.modal-sheet{background:var(--navy);border-radius:24px 24px 0 0;padding:20px 18px max(20px,env(safe-area-inset-bottom));width:100%;max-height:75vh;overflow-y:auto}
.modal-handle{width:36px;height:3px;border-radius:2px;background:rgba(255,255,255,0.2);margin:0 auto 16px}
.modal-title{font-size:15px;font-weight:500;color:#fff;margin-bottom:4px}
.modal-sub{font-size:11px;color:var(--light);margin-bottom:16px}
.modal-close{float:right;background:none;border:none;color:var(--light);font-size:20px;cursor:pointer}
.notif-item{background:rgba(255,255,255,0.07);border-radius:var(--radius-xs);padding:10px 12px;cursor:pointer;margin-bottom:6px}
.notif-item.unread{background:rgba(130,177,255,0.1);border:0.5px solid rgba(130,177,255,0.25)}
.notif-item-title{font-size:12px;font-weight:500;color:#fff}
.notif-item-meta{font-size:10px;color:var(--light);margin-top:2px}

/* Empty & Toast */
.empty-state{text-align:center;padding:30px 10px;color:var(--light);font-size:12px}
.toast{position:fixed;bottom:80px;left:50%;transform:translateX(-50%);background:var(--navy2);color:#fff;padding:10px 20px;border-radius:20px;font-size:12px;font-weight:500;z-index:999;opacity:0;transition:opacity 0.3s;pointer-events:none;white-space:nowrap;box-shadow:0 4px 16px rgba(0,0,0,0.25)}
.toast.show{opacity:1}

/* Loading */
.loading{text-align:center;padding:20px;color:var(--light);font-size:12px}
.loading::after{content:'';display:inline-block;width:16px;height:16px;border:2px solid var(--light);border-top-color:transparent;border-radius:50%;animation:spin .6s linear infinite;margin-left:8px;vertical-align:middle}
@keyframes spin{to{transform:rotate(360deg)}}
</style>
</head>
<body>
<div id="app">

<!-- LOGIN -->
<div id="screen-login" class="screen active">
  <div class="login-logo">
    <div class="login-logo-circle">MS</div>
    <h1>Mera Solutions</h1>
    <p>Portal de Recursos Humanos</p>
  </div>
  <div class="login-card">
    <div class="login-field">
      <label>Usuario</label>
      <input type="text" id="login-user" placeholder="usuario" autocomplete="username" autocapitalize="none" autocorrect="off">
    </div>
    <div class="login-field">
      <label>Contraseña</label>
      <input type="password" id="login-pass" placeholder="••••••••" autocomplete="current-password">
    </div>
    <button class="login-btn" onclick="doLogin()">Ingresar</button>
    <div class="login-error" id="login-error"></div>
    <div class="login-hint">Demo: admin / 1234 · empleado / 1234</div>
  </div>
</div>

<!-- EMPLOYEE -->
<div id="screen-employee" class="screen">
  <div class="topbar">
    <div class="topbar-left">
      <div class="avatar" id="emp-avatar">JM</div>
      <div><div class="tb-name" id="emp-name"></div><div class="tb-role" id="emp-role"></div></div>
    </div>
    <div class="topbar-right">
      <button class="tb-icon" onclick="openNotifications()">
